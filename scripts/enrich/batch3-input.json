[
 {
  "id": "jiangnanchun",
  "title": "江南春",
  "dynasty": "唐",
  "author": "杜牧",
  "lines": [
   "千里莺啼绿映红，",
   "水村山郭酒旗风。",
   "南朝四百八十寺，",
   "多少楼台烟雨中。"
  ]
 },
 {
  "id": "bochuaguazhou",
  "title": "泊船瓜洲",
  "dynasty": "宋",
  "author": "王安石",
  "lines": [
   "京口瓜洲一水间，",
   "钟山只隔数重山。",
   "春风又绿江南岸，",
   "明月何时照我还。"
  ]
 },
 {
  "id": "baimei",
  "title": "白梅",
  "dynasty": "元",
  "author": "王冕",
  "lines": [
   "冰雪林中著此身，",
   "不同桃李混芳尘。",
   "忽然一夜清香发，",
   "散作乾坤万里春。"
  ]
 },
 {
  "id": "momei",
  "title": "墨梅",
  "dynasty": "元",
  "author": "王冕",
  "lines": [
   "吾家洗砚池头树，",
   "个个花开淡墨痕。",
   "不要人夸好颜色，",
   "只留清气满乾坤。"
  ]
 },
 {
  "id": "zhushi",
  "title": "竹石",
  "dynasty": "清",
  "author": "郑燮",
  "lines": [
   "咬定青山不放松，",
   "立根原在破岩中。",
   "千磨万击还坚劲，",
   "任尔东西南北风。"
  ]
 },
 {
  "id": "jueju-huangli",
  "title": "绝句",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "两个黄鹂鸣翠柳，",
   "一行白鹭上青天。",
   "窗含西岭千秋雪，",
   "门泊东吴万里船。"
  ]
 },
 {
  "id": "hanye",
  "title": "寒夜",
  "dynasty": "宋",
  "author": "杜耒",
  "lines": [
   "寒夜客来茶当酒，",
   "竹炉汤沸火初红。",
   "寻常一样窗前月，",
   "才有梅花便不同。"
  ]
 },
 {
  "id": "muchunjishi",
  "title": "暮春即事",
  "dynasty": "宋",
  "author": "叶采",
  "lines": [
   "双双瓦雀行书案，",
   "点点杨花入砚池。",
   "闲坐小窗读周易，",
   "不知春去几多时。"
  ]
 },
 {
  "id": "chunyexiyu",
  "title": "春夜喜雨",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "好雨知时节，",
   "当春乃发生。",
   "随风潜入夜，",
   "润物细无声。",
   "野径云俱黑，",
   "江船火独明。",
   "晓看红湿处，",
   "花重锦官城。"
  ]
 },
 {
  "id": "wenguanjun",
  "title": "闻官军收河南河北",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "剑外忽传收蓟北，",
   "初闻涕泪满衣裳。",
   "却看妻子愁何在，",
   "漫卷诗书喜欲狂。",
   "白日放歌须纵酒，",
   "青春作伴好还乡。",
   "即从巴峡穿巫峡，",
   "便下襄阳向洛阳。"
  ]
 },
 {
  "id": "zenghuajing",
  "title": "赠花卿",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "锦城丝管日纷纷，",
   "半入江风半入云。",
   "此曲只应天上有，",
   "人间能得几回闻。"
  ]
 },
 {
  "id": "biedongda",
  "title": "别董大",
  "dynasty": "唐",
  "author": "高适",
  "lines": [
   "千里黄云白日曛，",
   "北风吹雁雪纷纷。",
   "莫愁前路无知己，",
   "天下谁人不识君。"
  ]
 },
 {
  "id": "songyuaner",
  "title": "送元二使安西",
  "dynasty": "唐",
  "author": "王维",
  "lines": [
   "渭城朝雨浥轻尘，",
   "客舍青青柳色新。",
   "劝君更尽一杯酒，",
   "西出阳关无故人。"
  ]
 },
 {
  "id": "huanghelou",
  "title": "黄鹤楼送孟浩然之广陵",
  "dynasty": "唐",
  "author": "李白",
  "lines": [
   "故人西辞黄鹤楼，",
   "烟花三月下扬州。",
   "孤帆远影碧空尽，",
   "唯见长江天际流。"
  ]
 },
 {
  "id": "duzuojingtingshan",
  "title": "独坐敬亭山",
  "dynasty": "唐",
  "author": "李白",
  "lines": [
   "众鸟高飞尽，",
   "孤云独去闲。",
   "相看两不厌，",
   "只有敬亭山。"
  ]
 },
 {
  "id": "qiuxi",
  "title": "秋夕",
  "dynasty": "唐",
  "author": "杜牧",
  "lines": [
   "银烛秋光冷画屏，",
   "轻罗小扇扑流萤。",
   "天阶夜色凉如水，",
   "坐看牵牛织女星。"
  ]
 },
 {
  "id": "chongyang",
  "title": "九月九日忆山东兄弟",
  "dynasty": "唐",
  "author": "王维",
  "lines": [
   "独在异乡为异客，",
   "每逢佳节倍思亲。",
   "遥知兄弟登高处，",
   "遍插茱萸少一人。"
  ]
 },
 {
  "id": "qiuyejiangxiao",
  "title": "秋夜将晓出篱门迎凉有感",
  "dynasty": "宋",
  "author": "陆游",
  "lines": [
   "三万里河东入海，",
   "五千仞岳上摩天。",
   "遗民泪尽胡尘里，",
   "南望王师又一年。"
  ]
 },
 {
  "id": "shuhuyin",
  "title": "书湖阴先生壁",
  "dynasty": "宋",
  "author": "王安石",
  "lines": [
   "茅檐长扫净无苔，",
   "花木成畦手自栽。",
   "一水护田将绿绕，",
   "两山排闼送青来。"
  ]
 }
]