[
 {
  "id": "fengxue",
  "title": "逢雪宿芙蓉山主人",
  "dynasty": "唐",
  "author": "刘长卿",
  "lines": [
   "日暮苍山远，",
   "天寒白屋贫。",
   "柴门闻犬吠，",
   "风雪夜归人。"
  ]
 },
 {
  "id": "xunyinzhe",
  "title": "寻隐者不遇",
  "dynasty": "唐",
  "author": "贾岛",
  "lines": [
   "松下问童子，",
   "言师采药去。",
   "只在此山中，",
   "云深不知处。"
  ]
 },
 {
  "id": "feng-liqiao",
  "title": "风",
  "dynasty": "唐",
  "author": "李峤",
  "lines": [
   "解落三秋叶，",
   "能开二月花。",
   "过江千尺浪，",
   "入竹万竿斜。"
  ]
 },
 {
  "id": "chan",
  "title": "蝉",
  "dynasty": "唐",
  "author": "虞世南",
  "lines": [
   "垂緌饮清露，",
   "流响出疏桐。",
   "居高声自远，",
   "非是藉秋风。"
  ]
 },
 {
  "id": "meihua",
  "title": "梅花",
  "dynasty": "宋",
  "author": "王安石",
  "lines": [
   "墙角数枝梅，",
   "凌寒独自开。",
   "遥知不是雪，",
   "为有暗香来。"
  ]
 },
 {
  "id": "jueju-chiri",
  "title": "绝句",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "迟日江山丽，",
   "春风花草香。",
   "泥融飞燕子，",
   "沙暖睡鸳鸯。"
  ]
 },
 {
  "id": "saixiaqu",
  "title": "塞下曲",
  "dynasty": "唐",
  "author": "卢纶",
  "lines": [
   "月黑雁飞高，",
   "单于夜遁逃。",
   "欲将轻骑逐，",
   "大雪满弓刀。"
  ]
 },
 {
  "id": "youyuanbuzhi",
  "title": "游园不值",
  "dynasty": "宋",
  "author": "叶绍翁",
  "lines": [
   "应怜屐齿印苍苔，",
   "小扣柴扉久不开。",
   "春色满园关不住，",
   "一枝红杏出墙来。"
  ]
 },
 {
  "id": "suojian",
  "title": "所见",
  "dynasty": "清",
  "author": "袁枚",
  "lines": [
   "牧童骑黄牛，",
   "歌声振林樾。",
   "意欲捕鸣蝉，",
   "忽然闭口立。"
  ]
 },
 {
  "id": "cunju",
  "title": "村居",
  "dynasty": "清",
  "author": "高鼎",
  "lines": [
   "草长莺飞二月天，",
   "拂堤杨柳醉春烟。",
   "儿童散学归来早，",
   "忙趁东风放纸鸢。"
  ]
 },
 {
  "id": "qingming",
  "title": "清明",
  "dynasty": "唐",
  "author": "杜牧",
  "lines": [
   "清明时节雨纷纷，",
   "路上行人欲断魂。",
   "借问酒家何处有，",
   "牧童遥指杏花村。"
  ]
 },
 {
  "id": "huichong",
  "title": "惠崇春江晚景",
  "dynasty": "宋",
  "author": "苏轼",
  "lines": [
   "竹外桃花三两枝，",
   "春江水暖鸭先知。",
   "蒌蒿满地芦芽短，",
   "正是河豚欲上时。"
  ]
 },
 {
  "id": "tixilinbi",
  "title": "题西林壁",
  "dynasty": "宋",
  "author": "苏轼",
  "lines": [
   "横看成岭侧成峰，",
   "远近高低各不同。",
   "不识庐山真面目，",
   "只缘身在此山中。"
  ]
 },
 {
  "id": "xiarijueju",
  "title": "夏日绝句",
  "dynasty": "宋",
  "author": "李清照",
  "lines": [
   "生当作人杰，",
   "死亦为鬼雄。",
   "至今思项羽，",
   "不肯过江东。"
  ]
 },
 {
  "id": "luchai",
  "title": "鹿柴",
  "dynasty": "唐",
  "author": "王维",
  "lines": [
   "空山不见人，",
   "但闻人语响。",
   "返景入深林，",
   "复照青苔上。"
  ]
 },
 {
  "id": "zhuliguan",
  "title": "竹里馆",
  "dynasty": "唐",
  "author": "王维",
  "lines": [
   "独坐幽篁里，",
   "弹琴复长啸。",
   "深林人不知，",
   "明月来相照。"
  ]
 },
 {
  "id": "songbie",
  "title": "送别",
  "dynasty": "唐",
  "author": "王维",
  "lines": [
   "山中相送罢，",
   "日暮掩柴扉。",
   "春草明年绿，",
   "王孙归不归。"
  ]
 },
 {
  "id": "shanxing",
  "title": "山行",
  "dynasty": "唐",
  "author": "杜牧",
  "lines": [
   "远上寒山石径斜，",
   "白云生处有人家。",
   "停车坐爱枫林晚，",
   "霜叶红于二月花。"
  ]
 }
]