[
 {
  "id": "wanghulou",
  "title": "六月二十七日望湖楼醉书",
  "dynasty": "宋",
  "author": "苏轼",
  "lines": [
   "黑云翻墨未遮山，",
   "白雨跳珠乱入船。",
   "卷地风来忽吹散，",
   "望湖楼下水如天。"
  ]
 },
 {
  "id": "zhouguoanren",
  "title": "舟过安仁",
  "dynasty": "宋",
  "author": "杨万里",
  "lines": [
   "一叶渔船两小童，",
   "收篙停棹坐船中。",
   "怪生无雨都张伞，",
   "不是遮头是使风。"
  ]
 },
 {
  "id": "shiyiyue",
  "title": "十一月四日风雨大作",
  "dynasty": "宋",
  "author": "陆游",
  "lines": [
   "僵卧孤村不自哀，",
   "尚思为国戍轮台。",
   "夜阑卧听风吹雨，",
   "铁马冰河入梦来。"
  ]
 },
 {
  "id": "hanshi",
  "title": "寒食",
  "dynasty": "唐",
  "author": "韩翃",
  "lines": [
   "春城无处不飞花，",
   "寒食东风御柳斜。",
   "日暮汉宫传蜡烛，",
   "轻烟散入五侯家。"
  ]
 },
 {
  "id": "chuzhouxijian",
  "title": "滁州西涧",
  "dynasty": "唐",
  "author": "韦应物",
  "lines": [
   "独怜幽草涧边生，",
   "上有黄鹂深树鸣。",
   "春潮带雨晚来急，",
   "野渡无人舟自横。"
  ]
 },
 {
  "id": "wuyixiang",
  "title": "乌衣巷",
  "dynasty": "唐",
  "author": "刘禹锡",
  "lines": [
   "朱雀桥边野草花，",
   "乌衣巷口夕阳斜。",
   "旧时王谢堂前燕，",
   "飞入寻常百姓家。"
  ]
 },
 {
  "id": "fengqiaoyebo",
  "title": "枫桥夜泊",
  "dynasty": "唐",
  "author": "张继",
  "lines": [
   "月落乌啼霜满天，",
   "江枫渔火对愁眠。",
   "姑苏城外寒山寺，",
   "夜半钟声到客船。"
  ]
 },
 {
  "id": "shier",
  "title": "示儿",
  "dynasty": "宋",
  "author": "陆游",
  "lines": [
   "死去元知万事空，",
   "但悲不见九州同。",
   "王师北定中原日，",
   "家祭无忘告乃翁。"
  ]
 },
 {
  "id": "tilinandi",
  "title": "题临安邸",
  "dynasty": "宋",
  "author": "林升",
  "lines": [
   "山外青山楼外楼，",
   "西湖歌舞几时休。",
   "暖风熏得游人醉，",
   "直把杭州作汴州。"
  ]
 },
 {
  "id": "liangzhouci-huan",
  "title": "凉州词",
  "dynasty": "唐",
  "author": "王之涣",
  "lines": [
   "黄河远上白云间，",
   "一片孤城万仞山。",
   "羌笛何须怨杨柳，",
   "春风不度玉门关。"
  ]
 },
 {
  "id": "langtaosha",
  "title": "浪淘沙",
  "dynasty": "唐",
  "author": "刘禹锡",
  "lines": [
   "九曲黄河万里沙，",
   "浪淘风簸自天涯。",
   "如今直上银河去，",
   "同到牵牛织女家。"
  ]
 },
 {
  "id": "zhuzhici",
  "title": "竹枝词",
  "dynasty": "唐",
  "author": "刘禹锡",
  "lines": [
   "杨柳青青江水平，",
   "闻郎江上唱歌声。",
   "东边日出西边雨，",
   "道是无晴却有晴。"
  ]
 },
 {
  "id": "congjunxing",
  "title": "从军行",
  "dynasty": "唐",
  "author": "王昌龄",
  "lines": [
   "青海长云暗雪山，",
   "孤城遥望玉门关。",
   "黄沙百战穿金甲，",
   "不破楼兰终不还。"
  ]
 },
 {
  "id": "kezhi",
  "title": "客至",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "舍南舍北皆春水，",
   "但见群鸥日日来。",
   "花径不曾缘客扫，",
   "蓬门今始为君开。",
   "盘飧市远无兼味，",
   "樽酒家贫只旧醅。",
   "肯与邻翁相对饮，",
   "隔篱呼取尽余杯。"
  ]
 },
 {
  "id": "wenwangchangling",
  "title": "闻王昌龄左迁龙标遥有此寄",
  "dynasty": "唐",
  "author": "李白",
  "lines": [
   "杨花落尽子规啼，",
   "闻道龙标过五溪。",
   "我寄愁心与明月，",
   "随君直到夜郎西。"
  ]
 },
 {
  "id": "baixuege",
  "title": "白雪歌送武判官归京（节选）",
  "dynasty": "唐",
  "author": "岑参",
  "lines": [
   "北风卷地白草折，",
   "胡天八月即飞雪。",
   "忽如一夜春风来，",
   "千树万树梨花开。",
   "散入珠帘湿罗幕，",
   "狐裘不暖锦衾薄。",
   "将军角弓不得控，",
   "都护铁衣冷难着。"
  ]
 },
 {
  "id": "jihaizashi",
  "title": "己亥杂诗",
  "dynasty": "清",
  "author": "龚自珍",
  "lines": [
   "九州生气恃风雷，",
   "万马齐喑究可哀。",
   "我劝天公重抖擞，",
   "不拘一格降人才。"
  ]
 }
]