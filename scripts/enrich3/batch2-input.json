[
 {
  "id": "lvye-shuhuai",
  "title": "旅夜书怀",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "细草微风岸，",
   "危樯独夜舟。",
   "星垂平野阔，",
   "月涌大江流。",
   "名岂文章著，",
   "官应老病休。",
   "飘飘何所似，",
   "天地一沙鸥。"
  ]
 },
 {
  "id": "deng-yueyanglou",
  "title": "登岳阳楼",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "昔闻洞庭水，",
   "今上岳阳楼。",
   "吴楚东南坼，",
   "乾坤日夜浮。",
   "亲朋无一字，",
   "老病有孤舟。",
   "戎马关山北，",
   "凭轩涕泗流。"
  ]
 },
 {
  "id": "hanjiang-lintiao",
  "title": "汉江临眺",
  "dynasty": "唐",
  "author": "王维",
  "lines": [
   "楚塞三湘接，",
   "荆门九派通。",
   "江流天地外，",
   "山色有无中。",
   "郡邑浮前浦，",
   "波澜动远空。",
   "襄阳好风日，",
   "留醉与山翁。"
  ]
 },
 {
  "id": "zhongnanshan",
  "title": "终南山",
  "dynasty": "唐",
  "author": "王维",
  "lines": [
   "太乙近天都，",
   "连山接海隅。",
   "白云回望合，",
   "青霭入看无。",
   "分野中峰变，",
   "阴晴众壑殊。",
   "欲投人处宿，",
   "隔水问樵夫。"
  ]
 },
 {
  "id": "guyao",
  "title": "古谣",
  "dynasty": "唐",
  "author": "王建",
  "lines": [
   "一东一西垄头水，",
   "一聚一散天边霞。",
   "一来一去道上客，",
   "一颠一倒池中麻。"
  ]
 },
 {
  "id": "ti-qiujianjudiaotu",
  "title": "题秋江独钓图",
  "dynasty": "清",
  "author": "王士祯",
  "lines": [
   "一蓑一笠一扁舟，",
   "一丈丝纶一寸钩。",
   "一曲高歌一樽酒，",
   "一人独钓一江秋。"
  ]
 },
 {
  "id": "shiwuyewangyue",
  "title": "十五夜望月寄杜郎中",
  "dynasty": "唐",
  "author": "王建",
  "lines": [
   "中庭地白树栖鸦，",
   "冷露无声湿桂花。",
   "今夜月明人尽望，",
   "不知秋思落谁家。"
  ]
 },
 {
  "id": "jianglou-ganjiu",
  "title": "江楼感旧",
  "dynasty": "唐",
  "author": "赵嘏",
  "lines": [
   "独上江楼思渺然，",
   "月光如水水如天。",
   "同来望月人何处？",
   "风景依稀似去年。"
  ]
 },
 {
  "id": "sudi-qingming",
  "title": "苏堤清明即事",
  "dynasty": "宋",
  "author": "吴惟信",
  "lines": [
   "梨花风起正清明，",
   "游子寻春半出城。",
   "日暮笙歌收拾去，",
   "万株杨柳属流莺。"
  ]
 },
 {
  "id": "wuxing-zashi",
  "title": "吴兴杂诗",
  "dynasty": "清",
  "author": "阮元",
  "lines": [
   "交流四水抱城斜，",
   "散作千溪遍万家。",
   "深处种菱浅种稻，",
   "不深不浅种荷花。"
  ]
 },
 {
  "id": "hanju",
  "title": "寒菊",
  "dynasty": "宋",
  "author": "郑思肖",
  "lines": [
   "花开不并百花丛，",
   "独立疏篱趣未穷。",
   "宁可枝头抱香死，",
   "何曾吹落北风中。"
  ]
 },
 {
  "id": "fangbingcao-humashi",
  "title": "房兵曹胡马诗",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "胡马大宛名，",
   "锋棱瘦骨成。",
   "竹批双耳峻，",
   "风入四蹄轻。",
   "所向无空阔，",
   "真堪托死生。",
   "骁腾有如此，",
   "万里可横行。"
  ]
 },
 {
  "id": "tianjingsha-chun",
  "title": "天净沙·春",
  "dynasty": "元",
  "author": "白朴",
  "lines": [
   "春山暖日和风，",
   "阑干楼阁帘栊，",
   "杨柳秋千院中。",
   "啼莺舞燕，",
   "小桥流水飞红。"
  ]
 },
 {
  "id": "tianjingsha-qiu",
  "title": "天净沙·秋",
  "dynasty": "元",
  "author": "白朴",
  "lines": [
   "孤村落日残霞，",
   "轻烟老树寒鸦，",
   "一点飞鸿影下。",
   "青山绿水，",
   "白草红叶黄花。"
  ]
 },
 {
  "id": "rumengling-changji",
  "title": "如梦令·常记溪亭日暮",
  "dynasty": "宋",
  "author": "李清照",
  "lines": [
   "常记溪亭日暮，",
   "沉醉不知归路。",
   "兴尽晚回舟，",
   "误入藕花深处。",
   "争渡，争渡，",
   "惊起一滩鸥鹭。"
  ]
 },
 {
  "id": "rumengling-zuoye",
  "title": "如梦令·昨夜雨疏风骤",
  "dynasty": "宋",
  "author": "李清照",
  "lines": [
   "昨夜雨疏风骤，",
   "浓睡不消残酒。",
   "试问卷帘人，",
   "却道海棠依旧。",
   "知否，知否？",
   "应是绿肥红瘦。"
  ]
 }
]