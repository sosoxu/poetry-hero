[
 {
  "id": "weiyu-dengcheng",
  "title": "微雨登城二首·其一",
  "dynasty": "宋",
  "author": "刘敞",
  "lines": [
   "雨映寒空半有无，",
   "重楼闲上倚城隅。",
   "浅深山色高低树，",
   "一片江南水墨图。"
  ]
 },
 {
  "id": "su-ganlusi-sengshe",
  "title": "宿甘露寺僧舍",
  "dynasty": "宋",
  "author": "曾公亮",
  "lines": [
   "枕中云气千峰近，",
   "床底松声万壑哀。",
   "要看银山拍天浪，",
   "开窗放入大江来。"
  ]
 },
 {
  "id": "jiangshang-wanganshi",
  "title": "江上",
  "dynasty": "宋",
  "author": "王安石",
  "lines": [
   "江北秋阴一半开，",
   "晚云含雨却低回。",
   "青山缭绕疑无路，",
   "忽见千帆隐映来。"
  ]
 },
 {
  "id": "jiaoxing-wanganshi",
  "title": "郊行",
  "dynasty": "宋",
  "author": "王安石",
  "lines": [
   "柔桑采尽绿阴稀，",
   "芦箔蚕成密茧肥。",
   "聊向村家问风俗，",
   "如何勤苦尚凶饥。"
  ]
 },
 {
  "id": "liuzhou-eryue",
  "title": "柳州二月榕叶落尽偶题",
  "dynasty": "唐",
  "author": "柳宗元",
  "lines": [
   "宦情羁思共凄凄，",
   "春半如秋意转迷。",
   "山城过雨百花尽，",
   "榕叶满庭莺乱啼。"
  ]
 },
 {
  "id": "chunguisi",
  "title": "春闺思",
  "dynasty": "唐",
  "author": "张仲素",
  "lines": [
   "袅袅城边柳，",
   "青青陌上桑。",
   "提笼忘采叶，",
   "昨夜梦渔阳。"
  ]
 },
 {
  "id": "cailianqu-liufangping",
  "title": "采莲曲",
  "dynasty": "唐",
  "author": "刘方平",
  "lines": [
   "落日清江里，",
   "荆歌艳楚腰。",
   "采莲从小惯，",
   "十五即乘潮。"
  ]
 },
 {
  "id": "gongzijia",
  "title": "公子家",
  "dynasty": "唐",
  "author": "聂夷中",
  "lines": [
   "种花满西园，",
   "花发青楼道。",
   "花下一禾生，",
   "去之为恶草。"
  ]
 },
 {
  "id": "gongci-qier",
  "title": "宫词五首·其二",
  "dynasty": "唐",
  "author": "顾况",
  "lines": [
   "玉楼天半起笙歌，",
   "风送宫嫔笑语和。",
   "月殿影开闻夜漏，",
   "水晶帘卷近银河。"
  ]
 },
 {
  "id": "chunsi-libai",
  "title": "春思",
  "dynasty": "唐",
  "author": "李白",
  "lines": [
   "燕草如碧丝，",
   "秦桑低绿枝。",
   "当君怀归日，",
   "是妾断肠时。",
   "春风不相识，",
   "何事入罗帏。"
  ]
 },
 {
  "id": "ziyewuge-dongge",
  "title": "子夜吴歌·冬歌",
  "dynasty": "唐",
  "author": "李白",
  "lines": [
   "明朝驿使发，",
   "一夜絮征袍。",
   "素手抽针冷，",
   "那堪把剪刀。",
   "裁缝寄远道，",
   "几日到临洮。"
  ]
 },
 {
  "id": "qingxixing",
  "title": "清溪行",
  "dynasty": "唐",
  "author": "李白",
  "lines": [
   "清溪清我心，",
   "水色异诸水。",
   "借问新安江，",
   "见底何如此。",
   "人行明镜中，",
   "鸟度屏风里。",
   "向晚猩猩啼，",
   "空悲远游子。"
  ]
 },
 {
  "id": "biefang-taiweimu",
  "title": "别房太尉墓",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "他乡复行役，",
   "驻马别孤坟。",
   "近泪无干土，",
   "低空有断云。",
   "对棋陪谢傅，",
   "把剑觅徐君。",
   "唯见林花落，",
   "莺啼送客闻。"
  ]
 },
 {
  "id": "shuxianzhumiao",
  "title": "蜀先主庙",
  "dynasty": "唐",
  "author": "刘禹锡",
  "lines": [
   "天地英雄气，",
   "千秋尚凛然。",
   "势分三足鼎，",
   "业复五铢钱。",
   "得相能开国，",
   "生儿不象贤。",
   "凄凉蜀故妓，",
   "来舞魏宫前。"
  ]
 },
 {
  "id": "fude-muyu-songlizhou",
  "title": "赋得暮雨送李胄",
  "dynasty": "唐",
  "author": "韦应物",
  "lines": [
   "楚江微雨里，",
   "建业暮钟时。",
   "漠漠帆来重，",
   "冥冥鸟去迟。",
   "海门深不见，",
   "浦树远含滋。",
   "相送情无限，",
   "沾襟比散丝。"
  ]
 },
 {
  "id": "beiqingluo",
  "title": "北青萝",
  "dynasty": "唐",
  "author": "李商隐",
  "lines": [
   "残阳西入崦，",
   "茅屋访孤僧。",
   "落叶人何在，",
   "寒云路几层。",
   "独敲初夜磬，",
   "闲倚一枝藤。",
   "世界微尘里，",
   "吾宁爱与憎。"
  ]
 }
]