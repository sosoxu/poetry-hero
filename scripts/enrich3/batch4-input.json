[
 {
  "id": "jueju-zhinan",
  "title": "绝句",
  "dynasty": "宋",
  "author": "志南",
  "lines": [
   "古木阴中系短篷，",
   "杖藜扶我过桥东。",
   "沾衣欲湿杏花雨，",
   "吹面不寒杨柳风。"
  ]
 },
 {
  "id": "yingsuo",
  "title": "莺梭",
  "dynasty": "宋",
  "author": "刘克庄",
  "lines": [
   "掷柳迁乔大有情，",
   "交交时作弄机声。",
   "洛阳三月春如锦，",
   "多少工夫织得成。"
  ]
 },
 {
  "id": "hushang-xuyuanjie",
  "title": "湖上",
  "dynasty": "宋",
  "author": "徐元杰",
  "lines": [
   "花开红树乱莺啼，",
   "草长平湖白鹭飞。",
   "风日晴和人意好，",
   "夕阳箫鼓几船归。"
  ]
 },
 {
  "id": "muchun-jishi",
  "title": "暮春即事",
  "dynasty": "宋",
  "author": "叶采",
  "lines": [
   "双双瓦雀行书案，",
   "点点杨花入砚池。",
   "闲坐小窗读周易，",
   "不知春去几多时。"
  ]
 },
 {
  "id": "hanye",
  "title": "寒夜",
  "dynasty": "宋",
  "author": "杜耒",
  "lines": [
   "寒夜客来茶当酒，",
   "竹炉汤沸火初红。",
   "寻常一样窗前月，",
   "才有梅花便不同。"
  ]
 },
 {
  "id": "tihua-yuanmei",
  "title": "题画",
  "dynasty": "清",
  "author": "袁枚",
  "lines": [
   "村落晚晴天，",
   "桃花映水鲜。",
   "牧童何处去？",
   "牛背一鸥眠。"
  ]
 },
 {
  "id": "zhenzhou-jueju",
  "title": "真州绝句",
  "dynasty": "清",
  "author": "王士祯",
  "lines": [
   "江干多是钓人居，",
   "柳陌菱塘一带疏。",
   "好是日斜风定后，",
   "半江红树卖鲈鱼。"
  ]
 },
 {
  "id": "shanzhong-liuke",
  "title": "山中留客",
  "dynasty": "唐",
  "author": "张旭",
  "lines": [
   "山光物态弄春晖，",
   "莫为轻阴便拟归。",
   "纵使晴明无雨色，",
   "入云深处亦沾衣。"
  ]
 },
 {
  "id": "yijia-biehushangting",
  "title": "移家别湖上亭",
  "dynasty": "唐",
  "author": "戎昱",
  "lines": [
   "好是春风湖上亭，",
   "柳条藤蔓系离情。",
   "黄莺久住浑相识，",
   "欲别频啼四五声。"
  ]
 },
 {
  "id": "qinzhenglou-xilaoliu",
  "title": "勤政楼西老柳",
  "dynasty": "唐",
  "author": "白居易",
  "lines": [
   "半朽临风树，",
   "多情立马人。",
   "开元一株柳，",
   "长庆二年春。"
  ]
 },
 {
  "id": "zengfanye",
  "title": "赠范晔",
  "dynasty": "南北朝",
  "author": "陆凯",
  "lines": [
   "折花逢驿使，",
   "寄与陇头人。",
   "江南无所有，",
   "聊赠一枝春。"
  ]
 },
 {
  "id": "renri-sigui",
  "title": "人日思归",
  "dynasty": "隋",
  "author": "薛道衡",
  "lines": [
   "入春才七日，",
   "离家已二年。",
   "人归落雁后，",
   "思发在花前。"
  ]
 },
 {
  "id": "yaozao-hanshandao",
  "title": "杳杳寒山道",
  "dynasty": "唐",
  "author": "寒山",
  "lines": [
   "杳杳寒山道，",
   "落落冷涧滨。",
   "啾啾常有鸟，",
   "寂寂更无人。",
   "淅淅风吹面，",
   "纷纷雪积身。",
   "朝朝不见日，",
   "岁岁不知春。"
  ]
 },
 {
  "id": "chongbie-zhoushangshu",
  "title": "重别周尚书",
  "dynasty": "南北朝",
  "author": "庾信",
  "lines": [
   "阳关万里道，",
   "不见一人归。",
   "惟有河边雁，",
   "秋来南向飞。"
  ]
 },
 {
  "id": "chuncao-tangyanqian",
  "title": "春草",
  "dynasty": "唐",
  "author": "唐彦谦",
  "lines": [
   "天南天北绕路边，",
   "托根无处不延绵。",
   "萋萋总是无情物，",
   "吹绿东风又一年。"
  ]
 },
 {
  "id": "chuncao-liuchang",
  "title": "春草",
  "dynasty": "宋",
  "author": "刘敞",
  "lines": [
   "春草绵绵不可名，",
   "水边原上乱抽荣。",
   "似嫌车马繁华地，",
   "才入城门便不生。"
  ]
 }
]