[
 {
  "id": "bashang-qiuju",
  "title": "灞上秋居",
  "dynasty": "唐",
  "author": "马戴",
  "lines": [
   "灞原风雨定，",
   "晚见雁行频。",
   "落叶他乡树，",
   "寒灯独夜人。",
   "空园白露滴，",
   "孤壁野僧邻。",
   "寄卧郊扉久，",
   "何年致此身。"
  ]
 },
 {
  "id": "chujiang-huaigu",
  "title": "楚江怀古",
  "dynasty": "唐",
  "author": "马戴",
  "lines": [
   "露气寒光集，",
   "微阳下楚丘。",
   "猿啼洞庭树，",
   "人在木兰舟。",
   "广泽生明月，",
   "苍山夹乱流。",
   "云中君不见，",
   "竟夕自悲秋。"
  ]
 },
 {
  "id": "chuye-youhuai",
  "title": "除夜有怀",
  "dynasty": "唐",
  "author": "崔涂",
  "lines": [
   "迢递三巴路，",
   "羁危万里身。",
   "乱山残雪夜，",
   "孤烛异乡人。",
   "渐与骨肉远，",
   "转于僮仆亲。",
   "那堪正飘泊，",
   "明日岁华新。"
  ]
 },
 {
  "id": "zhangtai-yesii",
  "title": "章台夜思",
  "dynasty": "唐",
  "author": "韦庄",
  "lines": [
   "清瑟怨遥夜，",
   "绕弦风雨哀。",
   "孤灯闻楚角，",
   "残月下章台。",
   "芳草已云暮，",
   "故人殊未来。",
   "乡书不可寄，",
   "秋雁又南回。"
  ]
 },
 {
  "id": "xun-luhongjian",
  "title": "寻陆鸿渐不遇",
  "dynasty": "唐",
  "author": "皎然",
  "lines": [
   "移家虽带郭，",
   "野径入桑麻。",
   "近种篱边菊，",
   "秋来未著花。",
   "扣门无犬吠，",
   "欲去问西家。",
   "报道山中去，",
   "归时每日斜。"
  ]
 },
 {
  "id": "yufu-zhangzhihe",
  "title": "渔父",
  "dynasty": "唐",
  "author": "张志和",
  "lines": [
   "西塞山前白鹭飞，",
   "桃花流水鳜鱼肥。",
   "青箬笠，绿蓑衣，",
   "斜风细雨不须归。"
  ]
 },
 {
  "id": "baixinyue",
  "title": "拜新月",
  "dynasty": "唐",
  "author": "李端",
  "lines": [
   "开帘见新月，",
   "便即下阶拜。",
   "细语人不闻，",
   "北风吹裙带。"
  ]
 },
 {
  "id": "gongzhongci",
  "title": "宫中词",
  "dynasty": "唐",
  "author": "朱庆馀",
  "lines": [
   "寂寂花时闭院门，",
   "美人相并立琼轩。",
   "含情欲说宫中事，",
   "鹦鹉前头不敢言。"
  ]
 },
 {
  "id": "jiren-zhangbi",
  "title": "寄人",
  "dynasty": "唐",
  "author": "张泌",
  "lines": [
   "别梦依依到谢家，",
   "小廊回合曲阑斜。",
   "多情只有春庭月，",
   "犹为离人照落花。"
  ]
 },
 {
  "id": "cailianzi-qi1",
  "title": "采莲子·其一",
  "dynasty": "唐",
  "author": "皇甫松",
  "lines": [
   "菡萏香连十顷陂，",
   "小姑贪戏采莲迟。",
   "晚来弄水船头湿，",
   "更脱红裙裹鸭儿。"
  ]
 },
 {
  "id": "cailianzi-qi2",
  "title": "采莲子·其二",
  "dynasty": "唐",
  "author": "皇甫松",
  "lines": [
   "船动湖光滟滟秋，",
   "贪看年少信船流。",
   "无端隔水抛莲子，",
   "遥被人知半日羞。"
  ]
 },
 {
  "id": "yeshang-shouxiangcheng",
  "title": "夜上受降城闻笛",
  "dynasty": "唐",
  "author": "李益",
  "lines": [
   "回乐烽前沙似雪，",
   "受降城外月如霜。",
   "不知何处吹芦管，",
   "一夜征人尽望乡。"
  ]
 },
 {
  "id": "jiangnanqu-yugu",
  "title": "江南曲",
  "dynasty": "唐",
  "author": "于鹄",
  "lines": [
   "偶向江边采白蘋，",
   "还随女伴赛江神。",
   "众中不敢分明语，",
   "暗掷金钱卜远人。"
  ]
 },
 {
  "id": "songyouren-xuetao",
  "title": "送友人",
  "dynasty": "唐",
  "author": "薛涛",
  "lines": [
   "水国蒹葭夜有霜，",
   "月寒山色共苍苍。",
   "谁言千里自今夕，",
   "离梦杳如关塞长。"
  ]
 },
 {
  "id": "guyi-liqi",
  "title": "古意",
  "dynasty": "唐",
  "author": "李颀",
  "lines": [
   "男儿事长征，",
   "少小幽燕客。",
   "赌胜马蹄下，",
   "由来轻七尺。",
   "杀人莫敢前，",
   "须如猬毛磔。",
   "黄云陇底白云飞，",
   "未得报恩不能归。",
   "辽东小妇年十五，",
   "惯弹琵琶解歌舞。",
   "今为羌笛出塞声，",
   "使我三军泪如雨。"
  ]
 },
 {
  "id": "zaohan-jiangshang",
  "title": "早寒江上有怀",
  "dynasty": "唐",
  "author": "孟浩然",
  "lines": [
   "木落雁南度，",
   "北风江上寒。",
   "我家襄水曲，",
   "遥隔楚云端。",
   "乡泪客中尽，",
   "孤帆天际看。",
   "迷津欲有问，",
   "平海夕漫漫。"
  ]
 }
]