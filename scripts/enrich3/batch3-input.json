[
 {
  "id": "rumengling-weixiang",
  "title": "如梦令·为向东坡传语",
  "dynasty": "宋",
  "author": "苏轼",
  "lines": [
   "为向东坡传语，",
   "人在玉堂深处。",
   "别后有谁来？",
   "雪压小桥无路。",
   "归去，归去，",
   "江上一犁春雨。"
  ]
 },
 {
  "id": "qiupuge",
  "title": "秋浦歌",
  "dynasty": "唐",
  "author": "李白",
  "lines": [
   "白发三千丈，",
   "缘愁似个长。",
   "不知明镜里，",
   "何处得秋霜。"
  ]
 },
 {
  "id": "qingpingle-cunju",
  "title": "清平乐·村居",
  "dynasty": "宋",
  "author": "辛弃疾",
  "lines": [
   "茅檐低小，",
   "溪上青青草。",
   "醉里吴音相媚好，",
   "白发谁家翁媪？",
   "大儿锄豆溪东，",
   "中儿正织鸡笼。",
   "最喜小儿亡赖，",
   "溪头卧剥莲蓬。"
  ]
 },
 {
  "id": "mushu",
  "title": "牧竖",
  "dynasty": "唐",
  "author": "崔道融",
  "lines": [
   "牧竖持蓑笠，",
   "逢人气傲然。",
   "卧牛吹短笛，",
   "耕却傍溪田。"
  ]
 },
 {
  "id": "junxing-libai",
  "title": "军行",
  "dynasty": "唐",
  "author": "李白",
  "lines": [
   "骝马新跨白玉鞍，",
   "战罢沙场月色寒。",
   "城头铁鼓声犹震，",
   "匣里金刀血未干。"
  ]
 },
 {
  "id": "banv-yao",
  "title": "巴女谣",
  "dynasty": "唐",
  "author": "于鹄",
  "lines": [
   "巴女骑牛唱竹枝，",
   "藕丝菱叶傍江时。",
   "不愁日暮还家错，",
   "记得芭蕉出槿篱。"
  ]
 },
 {
  "id": "tingzheng",
  "title": "听筝",
  "dynasty": "唐",
  "author": "李端",
  "lines": [
   "鸣筝金粟柱，",
   "素手玉房前。",
   "欲得周郎顾，",
   "时时误拂弦。"
  ]
 },
 {
  "id": "changan-eyou",
  "title": "长安夜游",
  "dynasty": "唐",
  "author": "袁不约",
  "lines": [
   "凤城连夜九门通，",
   "帝女皇妃出汉宫。",
   "千乘宝莲珠箔卷，",
   "万条银烛碧纱笼。",
   "歌声缓过青楼月，",
   "香霭潜来紫陌风。",
   "长乐晓钟归骑后，",
   "遗簪堕珥满街中。"
  ]
 },
 {
  "id": "wandie",
  "title": "晚蝶",
  "dynasty": "唐",
  "author": "王建",
  "lines": [
   "粉翅嫩如水，",
   "绕砌乍依风。",
   "日高山露解，",
   "飞入菊花中。"
  ]
 },
 {
  "id": "ziweihua",
  "title": "紫薇花",
  "dynasty": "唐",
  "author": "杜牧",
  "lines": [
   "晓迎秋露一枝新，",
   "不占园中最上春。",
   "桃李无言又何在，",
   "向风偏笑艳阳人。"
  ]
 },
 {
  "id": "xiju-liuzongyuan",
  "title": "溪居",
  "dynasty": "唐",
  "author": "柳宗元",
  "lines": [
   "久为簪组累，",
   "幸此南夷谪。",
   "闲依农圃邻，",
   "偶似山林客。",
   "晓耕翻露草，",
   "夜榜响溪石。",
   "来往不逢人，",
   "长歌楚天碧。"
  ]
 },
 {
  "id": "gongzixing",
  "title": "公子行",
  "dynasty": "唐",
  "author": "孟宾于",
  "lines": [
   "锦衣红夺彩霞明，",
   "侵晓春游向野庭。",
   "不识农夫辛苦力，",
   "骄骢踏烂麦青青。"
  ]
 },
 {
  "id": "tianweng",
  "title": "田翁",
  "dynasty": "唐",
  "author": "杜荀鹤",
  "lines": [
   "白发星星筋力衰，",
   "种田犹自伴孙儿。",
   "官苗若不平平纳，",
   "任是丰年也受饥。"
  ]
 },
 {
  "id": "canfu",
  "title": "蚕妇",
  "dynasty": "宋",
  "author": "张俞",
  "lines": [
   "昨日到城廓，",
   "归来泪满巾。",
   "遍身罗绮者，",
   "不是养蚕人。"
  ]
 },
 {
  "id": "tianjia-ouyangxiu",
  "title": "田家",
  "dynasty": "宋",
  "author": "欧阳修",
  "lines": [
   "绿桑高下映平川，",
   "赛罢田神笑语喧。",
   "林外鸣鸠春雨歇，",
   "屋头初日杏花繁。"
  ]
 },
 {
  "id": "xiangsi-ligou",
  "title": "乡思",
  "dynasty": "宋",
  "author": "李觏",
  "lines": [
   "人言落日是天涯，",
   "望极天涯不见家。",
   "已恨碧山相阻隔，",
   "碧山还被暮云遮。"
  ]
 }
]