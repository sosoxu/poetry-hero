[
 {
  "id": "kb-duzuo-jingtingshan",
  "title": "独坐敬亭山",
  "dynasty": "唐",
  "author": "李白",
  "lines": [
   "众鸟高飞尽，",
   "孤云独去闲。",
   "相看两不厌，",
   "只有敬亭山。"
  ]
 },
 {
  "id": "kb-biedongda",
  "title": "别董大",
  "dynasty": "唐",
  "author": "高适",
  "lines": [
   "千里黄云白日曛，",
   "北风吹雁雪纷纷。",
   "莫愁前路无知己，",
   "天下谁人不识君。"
  ]
 },
 {
  "id": "kb-jueju-huangli",
  "title": "绝句",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "两个黄鹂鸣翠柳，",
   "一行白鹭上青天。",
   "窗含西岭千秋雪，",
   "门泊东吴万里船。"
  ]
 },
 {
  "id": "kb-jueju-chiri",
  "title": "绝句",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "迟日江山丽，",
   "春风花草香。",
   "泥融飞燕子，",
   "沙暖睡鸳鸯。"
  ]
 },
 {
  "id": "kb-chunyexiyu",
  "title": "春夜喜雨",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "好雨知时节，",
   "当春乃发生。",
   "随风潜入夜，",
   "润物细无声。",
   "野径云俱黑，",
   "江船火独明。",
   "晓看红湿处，",
   "花重锦官城。"
  ]
 },
 {
  "id": "kb-jiangpan-xunhua",
  "title": "江畔独步寻花",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "黄四娘家花满蹊，",
   "千朵万朵压枝低。",
   "留连戏蝶时时舞，",
   "自在娇莺恰恰啼。"
  ]
 },
 {
  "id": "kb-fengqiaoyebo",
  "title": "枫桥夜泊",
  "dynasty": "唐",
  "author": "张继",
  "lines": [
   "月落乌啼霜满天，",
   "江枫渔火对愁眠。",
   "姑苏城外寒山寺，",
   "夜半钟声到客船。"
  ]
 },
 {
  "id": "kb-chuzhou-xijian",
  "title": "滁州西涧",
  "dynasty": "唐",
  "author": "韦应物",
  "lines": [
   "独怜幽草涧边生，",
   "上有黄鹂深树鸣。",
   "春潮带雨晚来急，",
   "野渡无人舟自横。"
  ]
 },
 {
  "id": "kb-youziyin",
  "title": "游子吟",
  "dynasty": "唐",
  "author": "孟郊",
  "lines": [
   "慈母手中线，",
   "游子身上衣。",
   "临行密密缝，",
   "意恐迟迟归。",
   "谁言寸草心，",
   "报得三春晖。"
  ]
 },
 {
  "id": "kb-zaochun-cheng",
  "title": "早春呈水部张十八员外",
  "dynasty": "唐",
  "author": "韩愈",
  "lines": [
   "天街小雨润如酥，",
   "草色遥看近却无。",
   "最是一年春好处，",
   "绝胜烟柳满皇都。"
  ]
 },
 {
  "id": "kb-yugezi",
  "title": "渔歌子",
  "dynasty": "唐",
  "author": "张志和",
  "lines": [
   "西塞山前白鹭飞，",
   "桃花流水鳜鱼肥。",
   "青箬笠，绿蓑衣，",
   "斜风细雨不须归。"
  ]
 },
 {
  "id": "kb-saixiaqu",
  "title": "塞下曲",
  "dynasty": "唐",
  "author": "卢纶",
  "lines": [
   "月黑雁飞高，",
   "单于夜遁逃。",
   "欲将轻骑逐，",
   "大雪满弓刀。"
  ]
 },
 {
  "id": "kb-wangdongting",
  "title": "望洞庭",
  "dynasty": "唐",
  "author": "刘禹锡",
  "lines": [
   "湖光秋月两相和，",
   "潭面无风镜未磨。",
   "遥望洞庭山水翠，",
   "白银盘里一青螺。"
  ]
 },
 {
  "id": "kb-langtaosha",
  "title": "浪淘沙",
  "dynasty": "唐",
  "author": "刘禹锡",
  "lines": [
   "九曲黄河万里沙，",
   "浪淘风簸自天涯。",
   "如今直上银河去，",
   "同到牵牛织女家。"
  ]
 },
 {
  "id": "kb-fude-guyuancao",
  "title": "赋得古原草送别（节选）",
  "dynasty": "唐",
  "author": "白居易",
  "lines": [
   "离离原上草，",
   "一岁一枯荣。",
   "野火烧不尽，",
   "春风吹又生。"
  ]
 },
 {
  "id": "kb-chishang",
  "title": "池上",
  "dynasty": "唐",
  "author": "白居易",
  "lines": [
   "小娃撑小艇，",
   "偷采白莲回。",
   "不解藏踪迹，",
   "浮萍一道开。"
  ]
 },
 {
  "id": "kb-yijiangnan",
  "title": "忆江南",
  "dynasty": "唐",
  "author": "白居易",
  "lines": [
   "江南好，",
   "风景旧曾谙。",
   "日出江花红胜火，",
   "春来江水绿如蓝。",
   "能不忆江南？"
  ]
 }
]