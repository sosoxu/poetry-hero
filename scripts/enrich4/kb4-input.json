[
 {
  "id": "kb-xiari-jueju",
  "title": "夏日绝句",
  "dynasty": "宋",
  "author": "李清照",
  "lines": [
   "生当作人杰，",
   "死亦为鬼雄。",
   "至今思项羽，",
   "不肯过江东。"
  ]
 },
 {
  "id": "kb-sanqu-daozhong",
  "title": "三衢道中",
  "dynasty": "宋",
  "author": "曾几",
  "lines": [
   "梅子黄时日日晴，",
   "小溪泛尽却山行。",
   "绿阴不减来时路，",
   "添得黄鹂四五声。"
  ]
 },
 {
  "id": "kb-shier",
  "title": "示儿",
  "dynasty": "宋",
  "author": "陆游",
  "lines": [
   "死去元知万事空，",
   "但悲不见九州同。",
   "王师北定中原日，",
   "家祭无忘告乃翁。"
  ]
 },
 {
  "id": "kb-qiuye-jiangxiao",
  "title": "秋夜将晓出篱门迎凉有感",
  "dynasty": "宋",
  "author": "陆游",
  "lines": [
   "三万里河东入海，",
   "五千仞岳上摩天。",
   "遗民泪尽胡尘里，",
   "南望王师又一年。"
  ]
 },
 {
  "id": "kb-sishi-1",
  "title": "四时田园杂兴（昼出）",
  "dynasty": "宋",
  "author": "范成大",
  "lines": [
   "昼出耘田夜绩麻，",
   "村庄儿女各当家。",
   "童孙未解供耕织，",
   "也傍桑阴学种瓜。"
  ]
 },
 {
  "id": "kb-sishi-2",
  "title": "四时田园杂兴（梅子）",
  "dynasty": "宋",
  "author": "范成大",
  "lines": [
   "梅子金黄杏子肥，",
   "麦花雪白菜花稀。",
   "日长篱落无人过，",
   "惟有蜻蜓蛱蝶飞。"
  ]
 },
 {
  "id": "kb-xiaochi",
  "title": "小池",
  "dynasty": "宋",
  "author": "杨万里",
  "lines": [
   "泉眼无声惜细流，",
   "树阴照水爱晴柔。",
   "小荷才露尖尖角，",
   "早有蜻蜓立上头。"
  ]
 },
 {
  "id": "kb-xiaochu-jingci",
  "title": "晓出净慈寺送林子方",
  "dynasty": "宋",
  "author": "杨万里",
  "lines": [
   "毕竟西湖六月中，",
   "风光不与四时同。",
   "接天莲叶无穷碧，",
   "映日荷花别样红。"
  ]
 },
 {
  "id": "kb-suxinshi-xugongdian",
  "title": "宿新市徐公店",
  "dynasty": "宋",
  "author": "杨万里",
  "lines": [
   "篱落疏疏一径深，",
   "树头新绿未成阴。",
   "儿童急走追黄蝶，",
   "飞入菜花无处寻。"
  ]
 },
 {
  "id": "kb-chunri",
  "title": "春日",
  "dynasty": "宋",
  "author": "朱熹",
  "lines": [
   "胜日寻芳泗水滨，",
   "无边光景一时新。",
   "等闲识得东风面，",
   "万紫千红总是春。"
  ]
 },
 {
  "id": "kb-guanshu-yougan",
  "title": "观书有感",
  "dynasty": "宋",
  "author": "朱熹",
  "lines": [
   "半亩方塘一鉴开，",
   "天光云影共徘徊。",
   "问渠那得清如许？",
   "为有源头活水来。"
  ]
 },
 {
  "id": "kb-tilinandi",
  "title": "题临安邸",
  "dynasty": "宋",
  "author": "林升",
  "lines": [
   "山外青山楼外楼，",
   "西湖歌舞几时休？",
   "暖风熏得游人醉，",
   "直把杭州作汴州。"
  ]
 },
 {
  "id": "kb-youyuanbuzhi",
  "title": "游园不值",
  "dynasty": "宋",
  "author": "叶绍翁",
  "lines": [
   "应怜屐齿印苍苔，",
   "小扣柴扉久不开。",
   "春色满园关不住，",
   "一枝红杏出墙来。"
  ]
 },
 {
  "id": "kb-yeshu-suojian",
  "title": "夜书所见",
  "dynasty": "宋",
  "author": "叶绍翁",
  "lines": [
   "萧萧梧叶送寒声，",
   "江上秋风动客情。",
   "知有儿童挑促织，",
   "夜深篱落一灯明。"
  ]
 },
 {
  "id": "kb-xiangcun-siyue",
  "title": "乡村四月",
  "dynasty": "宋",
  "author": "翁卷",
  "lines": [
   "绿遍山原白满川，",
   "子规声里雨如烟。",
   "乡村四月闲人少，",
   "才了蚕桑又插田。"
  ]
 },
 {
  "id": "kb-momei",
  "title": "墨梅",
  "dynasty": "元",
  "author": "王冕",
  "lines": [
   "吾家洗砚池头树，",
   "个个花开淡墨痕。",
   "不要人夸好颜色，",
   "只留清气满乾坤。"
  ]
 },
 {
  "id": "kb-shihuiyin",
  "title": "石灰吟",
  "dynasty": "明",
  "author": "于谦",
  "lines": [
   "千锤万凿出深山，",
   "烈火焚烧若等闲。",
   "粉骨碎身浑不怕，",
   "要留清白在人间。"
  ]
 }
]