[
 {
  "id": "kb-xiaoer-chuidiao",
  "title": "小儿垂钓",
  "dynasty": "唐",
  "author": "胡令能",
  "lines": [
   "蓬头稚子学垂纶，",
   "侧坐莓苔草映身。",
   "路人借问遥招手，",
   "怕得鱼惊不应人。"
  ]
 },
 {
  "id": "kb-minnong-2",
  "title": "悯农（其二）",
  "dynasty": "唐",
  "author": "李绅",
  "lines": [
   "锄禾日当午，",
   "汗滴禾下土。",
   "谁知盘中餐，",
   "粒粒皆辛苦。"
  ]
 },
 {
  "id": "kb-minnong-1",
  "title": "悯农（其一）",
  "dynasty": "唐",
  "author": "李绅",
  "lines": [
   "春种一粒粟，",
   "秋收万颗子。",
   "四海无闲田，",
   "农夫犹饿死。"
  ]
 },
 {
  "id": "kb-jiangxue",
  "title": "江雪",
  "dynasty": "唐",
  "author": "柳宗元",
  "lines": [
   "千山鸟飞绝，",
   "万径人踪灭。",
   "孤舟蓑笠翁，",
   "独钓寒江雪。"
  ]
 },
 {
  "id": "kb-xunyinzhe",
  "title": "寻隐者不遇",
  "dynasty": "唐",
  "author": "贾岛",
  "lines": [
   "松下问童子，",
   "言师采药去。",
   "只在此山中，",
   "云深不知处。"
  ]
 },
 {
  "id": "kb-shanxing",
  "title": "山行",
  "dynasty": "唐",
  "author": "杜牧",
  "lines": [
   "远上寒山石径斜，",
   "白云生处有人家。",
   "停车坐爱枫林晚，",
   "霜叶红于二月花。"
  ]
 },
 {
  "id": "kb-qingming",
  "title": "清明",
  "dynasty": "唐",
  "author": "杜牧",
  "lines": [
   "清明时节雨纷纷，",
   "路上行人欲断魂。",
   "借问酒家何处有，",
   "牧童遥指杏花村。"
  ]
 },
 {
  "id": "kb-jiangnanchun",
  "title": "江南春",
  "dynasty": "唐",
  "author": "杜牧",
  "lines": [
   "千里莺啼绿映红，",
   "水村山郭酒旗风。",
   "南朝四百八十寺，",
   "多少楼台烟雨中。"
  ]
 },
 {
  "id": "kb-feng-mifeng",
  "title": "蜂",
  "dynasty": "唐",
  "author": "罗隐",
  "lines": [
   "不论平地与山尖，",
   "无限风光尽被占。",
   "采得百花成蜜后，",
   "为谁辛苦为谁甜。"
  ]
 },
 {
  "id": "kb-jiangshang-yuzhe",
  "title": "江上渔者",
  "dynasty": "宋",
  "author": "范仲淹",
  "lines": [
   "江上往来人，",
   "但爱鲈鱼美。",
   "君看一叶舟，",
   "出没风波里。"
  ]
 },
 {
  "id": "kb-yuanri",
  "title": "元日",
  "dynasty": "宋",
  "author": "王安石",
  "lines": [
   "爆竹声中一岁除，",
   "春风送暖入屠苏。",
   "千门万户曈曈日，",
   "总把新桃换旧符。"
  ]
 },
 {
  "id": "kb-bochuan-guazhou",
  "title": "泊船瓜洲",
  "dynasty": "宋",
  "author": "王安石",
  "lines": [
   "京口瓜洲一水间，",
   "钟山只隔数重山。",
   "春风又绿江南岸，",
   "明月何时照我还。"
  ]
 },
 {
  "id": "kb-shuhuyin",
  "title": "书湖阴先生壁",
  "dynasty": "宋",
  "author": "王安石",
  "lines": [
   "茅檐长扫净无苔，",
   "花木成畦手自栽。",
   "一水护田将绿绕，",
   "两山排闼送青来。"
  ]
 },
 {
  "id": "kb-wanghulou",
  "title": "六月二十七日望湖楼醉书",
  "dynasty": "宋",
  "author": "苏轼",
  "lines": [
   "黑云翻墨未遮山，",
   "白雨跳珠乱入船。",
   "卷地风来忽吹散，",
   "望湖楼下水如天。"
  ]
 },
 {
  "id": "kb-yinhu-shang",
  "title": "饮湖上初晴后雨",
  "dynasty": "宋",
  "author": "苏轼",
  "lines": [
   "水光潋滟晴方好，",
   "山色空蒙雨亦奇。",
   "欲把西湖比西子，",
   "淡妆浓抹总相宜。"
  ]
 },
 {
  "id": "kb-huichong",
  "title": "惠崇春江晚景",
  "dynasty": "宋",
  "author": "苏轼",
  "lines": [
   "竹外桃花三两枝，",
   "春江水暖鸭先知。",
   "蒌蒿满地芦芽短，",
   "正是河豚欲上时。"
  ]
 },
 {
  "id": "kb-tixilinbi",
  "title": "题西林壁",
  "dynasty": "宋",
  "author": "苏轼",
  "lines": [
   "横看成岭侧成峰，",
   "远近高低各不同。",
   "不识庐山真面目，",
   "只缘身在此山中。"
  ]
 }
]