[
 {
  "id": "kb-zhushi",
  "title": "竹石",
  "dynasty": "清",
  "author": "郑燮",
  "lines": [
   "咬定青山不放松，",
   "立根原在破岩中。",
   "千磨万击还坚劲，",
   "任尔东西南北风。"
  ]
 },
 {
  "id": "kb-suojian",
  "title": "所见",
  "dynasty": "清",
  "author": "袁枚",
  "lines": [
   "牧童骑黄牛，",
   "歌声振林樾。",
   "意欲捕鸣蝉，",
   "忽然闭口立。"
  ]
 },
 {
  "id": "kb-cunju",
  "title": "村居",
  "dynasty": "清",
  "author": "高鼎",
  "lines": [
   "草长莺飞二月天，",
   "拂堤杨柳醉春烟。",
   "儿童散学归来早，",
   "忙趁东风放纸鸢。"
  ]
 },
 {
  "id": "kb-jihaizashi-220",
  "title": "己亥杂诗",
  "dynasty": "清",
  "author": "龚自珍",
  "lines": [
   "九州生气恃风雷，",
   "万马齐喑究可哀。",
   "我劝天公重抖擞，",
   "不拘一格降人才。"
  ]
 },
 {
  "id": "kb-zhouye-shu-suojuan",
  "title": "舟夜书所见",
  "dynasty": "清",
  "author": "查慎行",
  "lines": [
   "月黑见渔灯，",
   "孤光一点萤。",
   "微微风簇浪，",
   "散作满河星。"
  ]
 },
 {
  "id": "kb-huaji",
  "title": "画鸡",
  "dynasty": "明",
  "author": "唐寅",
  "lines": [
   "头上红冠不用裁，",
   "满身雪白走将来。",
   "平生不敢轻言语，",
   "一叫千门万户开。"
  ]
 },
 {
  "id": "kb-meihua",
  "title": "梅花",
  "dynasty": "宋",
  "author": "王安石",
  "lines": [
   "墙角数枝梅，",
   "凌寒独自开。",
   "遥知不是雪，",
   "为有暗香来。"
  ]
 },
 {
  "id": "kb-chongyang",
  "title": "九月九日忆山东兄弟",
  "dynasty": "唐",
  "author": "王维",
  "lines": [
   "独在异乡为异客，",
   "每逢佳节倍思亲。",
   "遥知兄弟登高处，",
   "遍插茱萸少一人。"
  ]
 },
 {
  "id": "kb-songyuaner",
  "title": "送元二使安西",
  "dynasty": "唐",
  "author": "王维",
  "lines": [
   "渭城朝雨浥轻尘，",
   "客舍青青柳色新。",
   "劝君更尽一杯酒，",
   "西出阳关无故人。"
  ]
 },
 {
  "id": "kb-chunxiao",
  "title": "春晓",
  "dynasty": "唐",
  "author": "孟浩然",
  "lines": [
   "春眠不觉晓，",
   "处处闻啼鸟。",
   "夜来风雨声，",
   "花落知多少。"
  ]
 },
 {
  "id": "kb-huanghelou-song",
  "title": "黄鹤楼送孟浩然之广陵",
  "dynasty": "唐",
  "author": "李白",
  "lines": [
   "故人西辞黄鹤楼，",
   "烟花三月下扬州。",
   "孤帆远影碧空尽，",
   "唯见长江天际流。"
  ]
 },
 {
  "id": "kb-baixuege",
  "title": "白雪歌送武判官归京（节选）",
  "dynasty": "唐",
  "author": "岑参",
  "lines": [
   "北风卷地白草折，",
   "胡天八月即飞雪。",
   "忽如一夜春风来，",
   "千树万树梨花开。"
  ]
 },
 {
  "id": "kb-wenwangchangling",
  "title": "闻王昌龄左迁龙标遥有此寄",
  "dynasty": "唐",
  "author": "李白",
  "lines": [
   "杨花落尽子规啼，",
   "闻道龙标过五溪。",
   "我寄愁心与明月，",
   "随君直到夜郎西。"
  ]
 },
 {
  "id": "kb-zenghuajing",
  "title": "赠花卿",
  "dynasty": "唐",
  "author": "杜甫",
  "lines": [
   "锦城丝管日纷纷，",
   "半入江风半入云。",
   "此曲只应天上有，",
   "人间能得几回闻。"
  ]
 },
 {
  "id": "kb-xiangsi-wangwei",
  "title": "相思",
  "dynasty": "唐",
  "author": "王维",
  "lines": [
   "红豆生南国，",
   "春来发几枝。",
   "愿君多采撷，",
   "此物最相思。"
  ]
 }
]